<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dbeaver.agent</groupId>
    <artifactId>dbeaver-agent</artifactId>
    <version>26.2-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <bytebuddy.version>1.18.11</bytebuddy.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>${bytebuddy.version}</version>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>${bytebuddy.version}</version>
        </dependency>

        <!-- <dependency>
            <groupId>com.dbeaver.lm</groupId>
            <artifactId>com.dbeaver.lm.api</artifactId>
            <version>3.0.35.202606291110</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/com.dbeaver.lm.api_3.0.35.202606291110.jar</systemPath>
        </dependency> -->

        <dependency>
            <groupId>com.dbeaver.datadam.lm</groupId>
            <artifactId>com.dbeaver.datadam.lm.api</artifactId>
            <version>3.0.42.202609071306.jar</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/com.dbeaver.lm.api_3.0.42.202609071306.jar</systemPath>
        </dependency>

        <!-- <dependency>
            <groupId>org.jkiss</groupId>
            <artifactId>utils</artifactId>
            <version>2.7.0.202606291110</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/org.jkiss.utils_2.7.0.202606291110.jar</systemPath>
        </dependency> -->

        <dependency>
            <groupId>org.jkiss</groupId>
            <artifactId>utils</artifactId>
            <version>2.8.0.202609071306</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/org.jkiss.utils_2.8.0.202609071306.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <index>true</index>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                            <addClasspath>true</addClasspath>
                        </manifest>
                        <manifestEntries>
                            <Premain-Class>com.dbeaver.agent.Agent</Premain-Class>
                            <Boot-Class-Path>${project.artifactId}.jar</Boot-Class-Path>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>